# CEREBRAS_MODEL=llama-3.3-70b

# 3. OpenRouter (one key, many :free models): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 4. Google Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# With no keys set, the bot falls back to built-in resume-grounded answers.
