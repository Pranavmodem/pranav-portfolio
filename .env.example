# ── AI chatbot (free tiers — set at least one for LLM answers) ──────────
# Providers are tried in this order; any that error/rate-limit fall through.

# 1. Groq (recommended — fastest, generous free tier): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# 2. Cerebras (free, very fast): https://cloud.cerebras.ai
